.build/
build/
.swiftpm/
*.xcodeproj
DerivedData/
.DS_Store
*.log
dist/

# Internal, not for publication (competitive/pricing strategy)
docs/COMPETITIVE.md

# Internal launch/credit playbook + marketing drafts (not for publication)
docs/launch/

# Deployment/marketing site + nginx/compose — infra, not the app (kept local; release.sh deploys it)
web/

# Real Crashbox DSN, injected into the bundle at package time by make-app.sh.
# The tracked Packaging/Info.plist keeps CrashboxDSN empty; never commit the DSN.
Packaging/crashbox-dsn.local

# Retired hosted-provider input (removed from the release Mac 2026-09-26). The
# release path never reads it; the entry stays so a restored copy is never committed.
Packaging/sentry-dsn.local

# Learning log is business analysis (internal ticket IDs, infra detail). This path
# is a symlink into a private store outside the repository; never track it.
docs/learning-log.md

# Local ops tooling from before the private origin (it mirrored to a backup remote).
# Kept ignored so a leftover copy is never committed.
Scripts/backup-repo.sh
