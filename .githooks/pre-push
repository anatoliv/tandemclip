#!/usr/bin/env bash
# Enable with:  git config core.hooksPath .githooks
# The release gate refuses to run until it is (Scripts/check-hooks-path.sh).
#
# Scans what is being pushed for secrets, LAN addresses, internal names and private
# paths. The maintainer's `origin` is a private repository and the public repository
# is a filtered mirror written only by a separate publish step, which runs its own
# guards. So a push to the private repository is warned about, not blocked, and a
# push anywhere else is treated as public and refused.
#
# git passes the remote NAME as $1 and its URL as $2. Forward both: the URL is how
# the scan tells the private repository from everything else. --pre-push is what
# tells the scanner to read git's ref list from stdin; without it the scanner never
# touches stdin, so a manual run from a non-interactive shell cannot hang.
exec "$(git rev-parse --show-toplevel)/Scripts/secret-scan.sh" --pre-push "$@"
